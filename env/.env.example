# --- Testing Willow Lodge (booking-app/) on your machine ---
# Copy this file to env/.env.dev. With APP_URL on localhost, Playwright starts
# the app for you, and APP_EMAIL / APP_PASSWORD become its admin login.
#   APP_URL=http://localhost:3000
#   API_URL=http://localhost:3000
#   APP_EMAIL=admin@willowlodge.test
#   APP_PASSWORD=pick-any-password

# Application URLs
APP_URL=https://your-app-url.com
API_URL=https://your-api-url.com

# Authentication Credentials
APP_EMAIL=your-email@example.com
APP_PASSWORD=your-secure-password

# Additional service URLs
UTILITY_URL=https://your-utility-service.com
