# Copy to booking-app/.env and change the values. booking-app/.env is git-ignored.
PORT=3000

# The one admin account. Pick your own; nothing in the code knows these values.
ADMIN_EMAIL=admin@willowlodge.test
ADMIN_PASSWORD=change-me-please

# Lets tests call POST /api/testing/reset to put the seed data back.
# Leave it off anywhere real people use the app.
ENABLE_TEST_RESET=true
